# Copy to keystore.properties (git-ignored) and fill in. Paths are relative to the project root.
# Alternatively set the environment variables DROPLINK_KEYSTORE_PATH, DROPLINK_KEYSTORE_PASSWORD,
# DROPLINK_KEY_ALIAS and DROPLINK_KEY_PASSWORD (that's what CI does).
storeFile=droplink-release.jks
storePassword=change-me
keyAlias=droplink
keyPassword=change-me
